# ===== CLOUD DATABASE (Neon PostgreSQL) =====
# Get these from https://neon.tech dashboard
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=recommendx
DB_SSL=false
# Optional full connection URI:
# DATABASE_URL=postgresql://user:password@host:5432/recommendx?sslmode=require

# ===== CLOUD REDIS (Redis Cloud) =====
# Get these from https://redis.com/try-free/ dashboard
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Optional full Redis URI:
# REDIS_URL=rediss://default:password@host:port

# ===== APPLICATION CONFIG =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
JWT_SECRET=recommendx_super_secret_jwt_key_cloud_2026
JWT_EXPIRES_IN=7d

# ===== SECURITY & RATE LIMITING =====
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
